{
  "name": "@d-i-t-a/reader",
  "version": "3.0.0-beta.1",
  "description": "A viewer application for EPUB files.",
  "repository": "https://github.com/d-i-t-a/R2D2BC",
  "license": "Apache-2.0",
  "main": "dist/esm/index.js",
  "typings": "dist/types/index.d.ts",
  "targets": {
    "main": false
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepare": "npm run build",
    "clean": "rimraf node_modules dist parcel-dist .parcel-cache",
    "dev": "ts-node -T build.ts -w",
    "build": "ts-node -T build.ts",
    "sass:debug": "sass --source-map src/styles/sass/:dist",
    "sass:release": "sass --style=compressed src/styles/sass/:dist",
    "examples": "npx ts-node examples/server.ts",
    "build:audiobook": "npx ts-node -T examples/buildAudiobookFromArchive.ts",
    "lint": "eslint '*/**/*.{js,ts,tsx}' --fix",
    "lint:css-vars": "ts-node -T scripts/check-readium-css-vars.ts",
    "example:clean": "rm -rf parcel-dist .parcel-cache",
    "example:react": "npm run example:clean && parcel examples/react/index.html --dist-dir parcel-dist",
    "example:vue": "npm run example:clean && parcel examples/vue/index.html --dist-dir parcel-dist --no-hmr",
    "example:angular": "npm run example:clean && parcel examples/angular/index.html --dist-dir parcel-dist",
    "example:nextjs": "npm run example:clean && parcel examples/nextjs/index.html --dist-dir parcel-dist",
    "example:remix": "npm run example:clean && parcel examples/remix/index.html --dist-dir parcel-dist",
    "example:pdf": "npm run build && npx ts-node examples/pdf/serve.ts",
    "example:vanilla": "npm run build && npx ts-node examples/vanilla/serve.ts",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@d-i-t-a/web-content-protection": "^1.1.1",
    "@readium/css": "^2.0.5",
    "@readium/shared": "^2.8.0",
    "browserslist-useragent-regexp": "^4.1.4",
    "cssesc": "^3.0.0",
    "debounce": "^3.0.0",
    "devtools-detector": "^2.0.25",
    "eventemitter3": "^5.0.4",
    "fflate": "^0.8.3",
    "jscrypto": "^1.0.3",
    "lodash": "^4.18.1",
    "loglevel": "^1.9.2",
    "pdfjs-dist": "^6.5.438",
    "recursive-readdir": "^2.2.3",
    "sanitize-html": "^2.18.1",
    "util": "^0.12.5",
    "uuid": "^14.0.3"
  },
  "browserslist": {
    "production": [
      "last 1 chrome version",
      "last 1 safari version",
      "last 1 edge version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 safari version",
      "last 1 edge version"
    ]
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@parcel/transformer-sass": "^2.16.4",
    "@parcel/transformer-typescript-tsc": "^2.16.4",
    "@parcel/transformer-vue": "^2.16.4",
    "@types/cssesc": "^3.0.2",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "ansi-regex": "^6.5.0",
    "braces": "^3.0.3",
    "buffer": "^6.0.3",
    "chalk": "^6.0.1",
    "chokidar": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "express": "^5.3.0",
    "glob": "^14.0.3",
    "globals": "^17.14.0",
    "json-schema": "^0.4.0",
    "parcel": "^2.16.4",
    "parcel-config-precache-manifest": "^0.0.4",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "prettier": "^3.9.10",
    "process": "^0.11.10",
    "r2-streamer-js": "^1.0.51",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.4",
    "sass": "^1.107.1",
    "tar": "^7.5.22",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vue": "^3.5.44"
  },
  "files": [
    "dist"
  ],
  "resolutions": {
    "braces": "3.0.3"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "es5"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "overrides": {
    "request": "npm:@cypress/request@^4.0.1",
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "js-beautify": {
      "glob": "14.0.3",
      "minimatch": "11.0.4"
    },
    "editorconfig": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.4"
    },
    "eslint": {
      "minimatch": "11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    },
    "typedoc": {
      "minimatch": "10.2.6"
    }
  }
}
